# Supabase — required for production and multi-device sync.
# Create a project at https://supabase.com and copy these from Settings → API.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional. Set to "local" to persist data in the browser (IndexedDB)
# without a Supabase project. Never use this in production.
# VITE_DATA_BACKEND=local

# Insights API (FastAPI). Leave as /api when using the Vite proxy.
VITE_INSIGHTS_API_URL=/api

# Backend (copy into backend/.env). Never commit secrets.
# NVIDIA_API_KEY=
# NVIDIA_MODEL=moonshotai/kimi-k3
# DATABASE_URL=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
# SUPABASE_JWKS_URL=
# SUPABASE_JWT_SECRET=
